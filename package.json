      "types": "./dist/unooblog/index.d.ts",
      "import": "./dist/unooblog/index.mjs",
      "require": "./dist/unooblog/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./unooria.css": "./dist/styles-unooria.css",
    "./instanooria.css": "./dist/styles-instanooria.css",
    "./chatgpt.css": "./dist/styles-chatgpt.css",
    "./whatsappmobile.css": "./dist/styles-whatsappmobile.css",
    "./tiktooria.css": "./dist/styles-tiktooria.css",
    "./unootube.css": "./dist/styles-unootube.css",
    "./unoochat.css": "./dist/styles-unoochat.css",
    "./unoovista.css": "./dist/styles-unoovista.css",
    "./unooriaai.css": "./dist/styles-unooriaai.css",
    "./unoogaleria.css": "./dist/styles-unoogaleria.css",
    "./unoojornal.css": "./dist/styles-unoojornal.css",
    "./unooblog.css": "./dist/styles-unooblog.css",
    "./fonts/unooria.css": "./dist/fonts/unooria.css",
