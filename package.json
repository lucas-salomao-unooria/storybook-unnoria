    "./fonts/whatsappmobile.css": "./dist/fonts/whatsappmobile.css",
    "./fonts/tiktooria.css": "./dist/fonts/tiktooria.css",
    "./fonts/unootube.css": "./dist/fonts/unootube.css",
    "./fonts/unoochat.css": "./dist/fonts/unoochat.css",
    "./fonts/unoovista.css": "./dist/fonts/unoovista.css",
    "./fonts/unooriaai.css": "./dist/fonts/unooriaai.css",
    "./fonts/unoogaleria.css": "./dist/fonts/unoogaleria.css",
    "./fonts/unoojornal.css": "./dist/fonts/unoojornal.css",
    "./fonts/unooblog.css": "./dist/fonts/unooblog.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "!src/fonts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "build:package": "npm run verificar:css && npm run verificar:paridade-unoochat && npm run verificar:paridade-unoovista && npm run verificar:paridade-unooriaai && npm run verificar:paridade-unoogaleria && npm run verificar:paridade-unoojornal && npm run verificar:paridade-unooblog && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist && node scripts/corrigir-specifiers.mjs && node scripts/verificar-esm.mjs",
    "prepublishOnly": "npm run build:package",
    "verificar:css": "node scripts/verificar-css-agregado.mjs",
    "fontes": "node scripts/baixar-fontes.mjs",
    "inventario": "node scripts/gerar-inventario-componentes.mjs",
    "verificar:paridade-unoochat": "node scripts/verificar-paridade-unoochat.mjs",
    "verificar:paridade-unoovista": "node scripts/verificar-paridade-unoovista.mjs",
    "verificar:paridade-unooriaai": "node scripts/verificar-paridade-unooriaai.mjs",
    "verificar:paridade-unoogaleria": "node scripts/verificar-paridade-unoogaleria.mjs",
    "verificar:paridade-unoojornal": "node scripts/verificar-paridade-unoojornal.mjs",
    "verificar:paridade-unooblog": "node scripts/verificar-paridade-unooblog.mjs",
    "gerar:tokens-unoojornal": "node scripts/gerar-tokens-unoojornal.mjs",
    "gerar:tokens-unooblog": "node scripts/gerar-tokens-unooblog.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-storybook": "^10.5.7",
    "playwright": "latest",
    "storybook": "^10.5.7",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "latest"
  }
}
