{
  "name": "@unooria/design-system",
  "version": "0.1.13",
  "description": "Design System oficial da Plataforma Unooria para React e Next.js com suporte completo a temas Light/Dark",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./unooria": {
      "types": "./dist/unooria/index.d.ts",
      "import": "./dist/unooria/index.mjs",
      "require": "./dist/unooria/index.cjs"
    },
    "./instanooria": {
      "types": "./dist/instanooria/index.d.ts",
      "import": "./dist/instanooria/index.mjs",
      "require": "./dist/instanooria/index.cjs"
    },
    "./chatgpt": {
      "types": "./dist/chatgpt/index.d.ts",
      "import": "./dist/chatgpt/index.mjs",
      "require": "./dist/chatgpt/index.cjs"
    },
    "./whatsappmobile": {
      "types": "./dist/whatsappmobile/index.d.ts",
      "import": "./dist/whatsappmobile/index.mjs",
      "require": "./dist/whatsappmobile/index.cjs"
    },
    "./tiktooria": {
      "types": "./dist/tiktooria/index.d.ts",
      "import": "./dist/tiktooria/index.mjs",
      "require": "./dist/tiktooria/index.cjs"
    },
    "./unootube": {
      "types": "./dist/unootube/index.d.ts",
      "import": "./dist/unootube/index.mjs",
      "require": "./dist/unootube/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./unooria.css": "./dist/styles-unooria.css",
    "./instanooria.css": "./dist/styles-instanooria.css",
    "./chatgpt.css": "./dist/styles-chatgpt.css",
    "./whatsappmobile.css": "./dist/styles-whatsappmobile.css",
    "./tiktooria.css": "./dist/styles-tiktooria.css",
    "./unootube.css": "./dist/styles-unootube.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "build:package": "npm run verificar:css && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist && node scripts/corrigir-specifiers.mjs && node scripts/verificar-esm.mjs",
    "prepublishOnly": "npm run build:package",
    "verificar:css": "node scripts/verificar-css-agregado.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-storybook": "^10.5.7",
    "playwright": "latest",
    "storybook": "^10.5.7",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "latest"
  }
}
